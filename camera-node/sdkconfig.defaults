# NOTE: only applied when PlatformIO creates sdkconfig.camera.
# After changing this file, delete sdkconfig.camera so it is regenerated.

# --- ESP32-S3-DevKitC-1 N16R8: 16 MB quad flash, 8 MB octal PSRAM ---
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y

# Logs on the "UART" USB port
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_FREERTOS_HZ=1000

# --- Camera driver ---
CONFIG_OV5640_SUPPORT=y
# Autofocus (only used if the installed driver version has it)
CONFIG_CAMERA_AF_SUPPORT=y
CONFIG_CAMERA_CORE1=y

# --- WiFi: room for a few frames in flight ---
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=10
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=32
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=32
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=16384
CONFIG_LWIP_TCP_WND_DEFAULT=16384
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
# Two web servers (control + stream) need more sockets than the default 10
CONFIG_LWIP_MAX_SOCKETS=16
