# NOTE: these are only applied when PlatformIO creates sdkconfig.display.
# After changing this file, delete sdkconfig.display so it is regenerated.

# --- AgIsoStack++ needs ---
# Larger than the library example (8192): the VT server parses the object pool in its own thread
CONFIG_PTHREAD_TASK_STACK_SIZE_DEFAULT=16384
CONFIG_FREERTOS_HZ=250
# The main task runs the CAN stack and builds the screen
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384

# --- Waveshare ESP32-S3-Touch-LCD-7: ESP32-S3N16R8 ---
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# 8 MB octal PSRAM, used automatically by malloc/new for large blocks (object pool, frame buffer)
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
# Same PSRAM/cache tuning as Waveshare's LVGL example: keeps the RGB panel stable
CONFIG_SPIRAM_XIP_FROM_PSRAM=y
CONFIG_SPIRAM_RODATA=y
CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y
# Re-sync the panel every frame, avoids a shifted picture if PSRAM is briefly busy
CONFIG_LCD_RGB_RESTART_IN_VSYNC=y

# Logs go to UART0 = the USB-to-UART Type-C port (native USB pins are used for CAN)
CONFIG_ESP_CONSOLE_UART_DEFAULT=y

# --- LVGL 8.3 ---
CONFIG_LV_COLOR_DEPTH_16=y
# CONFIG_LV_COLOR_16_SWAP is not set
CONFIG_LV_MEM_CUSTOM=y
CONFIG_LV_MEMCPY_MEMSET_STD=y
CONFIG_LV_ATTRIBUTE_FAST_MEM_USE_IRAM=y
CONFIG_LV_DISP_DEF_REFR_PERIOD=20
CONFIG_LV_INDEV_DEF_READ_PERIOD=20
CONFIG_LV_FONT_MONTSERRAT_8=y
CONFIG_LV_FONT_MONTSERRAT_10=y
CONFIG_LV_FONT_MONTSERRAT_12=y
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_24=y
CONFIG_LV_FONT_MONTSERRAT_28=y
CONFIG_LV_FONT_MONTSERRAT_32=y
CONFIG_LV_FONT_MONTSERRAT_40=y
CONFIG_LV_FONT_MONTSERRAT_48=y
CONFIG_LV_FONT_DEFAULT_MONTSERRAT_14=y
# CONFIG_LV_USE_LOG is not set
# CONFIG_LV_USE_PERF_MONITOR is not set
